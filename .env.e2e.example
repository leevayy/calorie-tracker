NODE_ENV=test
JWT_SECRET=e2e-only-jwt-secret-at-least-16-characters
E2E_BASE_URL=http://127.0.0.1:4173
E2E_API_URL=http://127.0.0.1:3000
E2E_TEST_MODE=1
E2E_CONTROL_SECRET=e2e-control-secret-at-least-16-characters
E2E_TEST_EMAIL=playwright@example.invalid
E2E_TEST_PASSWORD=playwright-local-only-password
E2E_ARTIFACT_DIR=artifacts/playwright/redacted

# Omit DATABASE_URL to let scripts/e2e.mjs manage a disposable local PostgreSQL 16
# cluster under .cache/e2e-postgres. CI and existing database users may instead set:
# DATABASE_URL=postgresql://calorie_e2e:password@127.0.0.1:5432/calorie_tracker_e2e
# E2E_MANAGE_POSTGRES=0

# Required only by `npm run e2e:live`:
# E2E_LIVE_AI=1
# YANDEX_AI_STUDIO_API_KEY=
# YANDEX_FOLDER_ID=
